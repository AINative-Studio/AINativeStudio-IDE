# AINative API Configuration
# This file contains example environment variables for AINative Studio IDE
# Copy this file to .env.development, .env.production, or .env.test as needed
# DO NOT commit actual .env files to version control

# AINative API Base URL
AINATIVE_API_BASE_URL=https://api.ainative.studio

# API Request Timeout (milliseconds)
AINATIVE_API_TIMEOUT=30000

# Environment
NODE_ENV=development

# Security Configuration
# Encryption key identifier for token storage
ENCRYPTION_KEY_ID=ainative-auth-tokens

# Token Storage Provider
# Options: electron-safe-storage, keychain (OS-specific), memory (development only)
TOKEN_STORAGE_PROVIDER=electron-safe-storage

# Session Configuration
# Session timeout in milliseconds (default: 30 minutes)
SESSION_TIMEOUT=1800000

# Session activity check interval (default: 60 seconds)
SESSION_CHECK_INTERVAL=60000

# Feature Flags
# Enable/disable AINative authentication
ENABLE_AINATIVE_AUTH=true

# Enable/disable AINative Cloud authentication
ENABLE_AINATIVE_CLOUD=true

# Enable/disable AI model integration
ENABLE_AI_MODELS=true

# Enable/disable community marketplace
ENABLE_MARKETPLACE=true

# Cloud Sync Configuration
# Sync interval for cloud data (milliseconds, default: 5 minutes)
AINATIVE_SYNC_INTERVAL=300000

# Auto-sync usage statistics with cloud
ENABLE_AUTO_SYNC=true

# Logging Configuration
# Log level: trace, debug, info, warn, error
LOG_LEVEL=info

# Enable verbose logging for authentication flow
ENABLE_AUTH_LOGGING=false

# Network Security
# Enforce HTTPS for all API calls
ENFORCE_HTTPS=true

# Enable certificate pinning (production only)
ENABLE_CERT_PINNING=false

# Certificate fingerprint (production only - update with actual value)
CERT_FINGERPRINT=

# Development Settings
# Allow insecure connections (development only - DO NOT enable in production)
ALLOW_INSECURE_CONNECTIONS=false

# Enable development mode features
DEVELOPMENT_MODE=true

# Performance Configuration
# Maximum concurrent API requests
MAX_CONCURRENT_REQUESTS=5

# Request retry attempts
MAX_RETRY_ATTEMPTS=3

# Retry delay (milliseconds)
RETRY_DELAY=1000
