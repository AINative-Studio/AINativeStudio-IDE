# AINative Studio - Test Environment Configuration

# API Configuration
AINATIVE_API_BASE_URL=https://api.ainative.studio
AINATIVE_API_TIMEOUT=10000

# Environment
NODE_ENV=test

# Security
ENCRYPTION_KEY_ID=ainative-auth-tokens-test
TOKEN_STORAGE_PROVIDER=memory

# Session Configuration
SESSION_TIMEOUT=300000
SESSION_CHECK_INTERVAL=5000

# Feature Flags
ENABLE_AINATIVE_AUTH=true
ENABLE_AI_MODELS=true
ENABLE_MARKETPLACE=false

# Logging
LOG_LEVEL=warn
ENABLE_AUTH_LOGGING=false

# Network Security
ENFORCE_HTTPS=true
ENABLE_CERT_PINNING=false
ALLOW_INSECURE_CONNECTIONS=true

# Development Settings
DEVELOPMENT_MODE=true

# Performance
MAX_CONCURRENT_REQUESTS=3
MAX_RETRY_ATTEMPTS=2
RETRY_DELAY=500
